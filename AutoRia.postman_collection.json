            },
            "auth": {
              "type": "noauth"
            },
            "description": "Refresh tokens are single use.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "const t = b.tokens ?? b;",
                  "if (t.accessToken) pm.collectionVariables.set('accessToken', t.accessToken);",
                  "if (t.refreshToken) pm.collectionVariables.set('refreshToken', t.refreshToken);",
                  "if (b.user?._id) pm.collectionVariables.set('userId', b.user._id);"
                ]
              }
            }
          ]
        },
